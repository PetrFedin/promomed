{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promomed:schema:federation-discovery-bundle:v1",
  "title": "Promomed Federation Discovery Bundle v1",
  "type": "object",
  "required": [
    "payload",
    "signature",
    "statementSha256"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "statementVersion",
        "statementType",
        "issuerId",
        "keyId",
        "alg",
        "issuedAt",
        "body",
        "medicalEfficacyCertified"
      ],
      "properties": {
        "statementVersion": {
          "const": "promomed-portable-statement-v1"
        },
        "statementType": {
          "const": "promomed-federation-discovery-bundle-v1"
        },
        "issuerId": {
          "type": "string",
          "minLength": 1
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "alg": {
          "const": "Ed25519"
        },
        "issuedAt": {
          "type": "integer"
        },
        "medicalEfficacyCertified": {
          "const": false
        },
        "body": {
          "type": "object",
          "required": [
            "bundleVersion",
            "organizationId",
            "profile",
            "evaluation",
            "anchors",
            "did",
            "jwks",
            "issuedAt",
            "validUntil",
            "truthBoundary"
          ],
          "properties": {
            "bundleVersion": {
              "const": "promomed-federation-discovery-bundle-v1"
            },
            "organizationId": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "object",
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "const": "promomed-federation-interop-v1"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            "evaluation": {
              "type": "object"
            },
            "anchors": {
              "type": "array"
            },
            "did": {
              "type": "object"
            },
            "jwks": {
              "type": "object"
            },
            "issuedAt": {
              "type": "integer"
            },
            "validUntil": {
              "type": "integer"
            },
            "truthBoundary": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "minLength": 40
    },
    "statementSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
